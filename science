<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Library สำหรับถ่ายภาพหน้าจอ -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script src="https://unpkg.com/react@17/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@17/umd/react-dom.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <style>
    body { font-family: 'Sarabun', sans-serif; background: linear-gradient(135deg, #f0f9ff 0%, #e0e7ff 50%, #fae8ff 100%); color: #334155; min-height: 100vh; }
    .glass-card { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 1); box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.08); }
    .period-chip { transition: all 0.2s ease; background: white; border: 1px solid #e2e8f0; }
    .period-chip:hover { border-color: #3b82f6; transform: translateY(-2px); }
    .period-chip.active { background: linear-gradient(135deg, #3b82f6, #8b5cf6); color: white; border-color: transparent; box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3); }
    .gradient-text { background: linear-gradient(135deg, #2563eb, #9333ea); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .clickable-bar { cursor: pointer; transition: transform 0.1s; }
    .clickable-bar:hover { transform: scale(1.02); }
  </style>
</head>
<body>
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect } = React;

    const DAYS_TH = ['อาทิตย์', 'จันทร์', 'อังคาร', 'พุธ', 'พฤหัสบดี', 'ศุกร์', 'เสาร์'];
    const MONTHS_TH_SHORT = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
    const PERIODS = [1, 2, 3, 4, 5, 6, 7, 8];
    const LEAVE_TYPES = ['ลากิจ', 'ลาป่วย', 'ไปราชการ', 'ประชุม'];
    
    // ตั้งค่าบทบาทพิเศษ
    const SPECIAL_ROLES = {
      'นางกรกนก หาญไชยนะ': 'หัวหน้ากลุ่มบริหาร',
      'นายพัลลภ ทองหล่อ': 'หัวหน้ากลุ่มบริหาร',
      'นายณรงค์ศักดิ์ หงษ์ตะนุ': 'หัวหน้ากลุ่มบริหาร',
      'นางปุณญิสา ศรีชมภู': 'เจ้าหน้าที่สำนักงาน'
    };

    function App() {
      const [activeTab, setActiveTab] = useState('manage'); 
      const [isLoading, setIsLoading] = useState(true);
      const [isSaving, setIsSaving] = useState(false);
      const [hasSaved, setHasSaved] = useState(false);
      
      const [showConfirmModal, setShowConfirmModal] = useState(false);
      const [showSuccessModal, setShowSuccessModal] = useState(false);

      const [scheduleData, setScheduleData] = useState([]);
      const [teachersList, setTeachersList] = useState([]);
      const [stats, setStats] = useState({});
      const [leaveRequests, setLeaveRequests] = useState([]);
      const [assignments, setAssignments] = useState([]);
      
      const [selectedTeacherLeave, setSelectedTeacherLeave] = useState(null);
      const [selectedScheduleDay, setSelectedScheduleDay] = useState('จันทร์'); 
      
      const [currentForm, setCurrentForm] = useState({
        teacherName: '', reason: 'ลากิจ', date: new Date().toISOString().split('T')[0], selectedPeriods: [] 
      });

      useEffect(() => {
        google.script.run.withSuccessHandler((response) => {
          const res = JSON.parse(response);
          if (res.success) {
            setScheduleData(res.data);
            const unique = {};
            res.data.forEach(item => { if (item.teacherName && !unique[item.teacherName]) unique[item.teacherName] = { name: item.teacherName, dept: item.dept }; });
            const tList = Object.values(unique);
            setTeachersList(tList);
            
            google.script.run.withSuccessHandler((s) => { 
              let parsedStats = JSON.parse(s);
              let initialStats = {};
              tList.forEach(t => { 
                initialStats[t.name] = parsedStats[t.name] || { leaveCount: 0, subCount: 0, leaveHistory: [] }; 
                if(!initialStats[t.name].leaveHistory) initialStats[t.name].leaveHistory = [];
              });
              setStats(initialStats); 
              setIsLoading(false); 
            }).getStats();
          }
        }).getScheduleData();
      }, []);

      const formatThaiDate = (dateStr) => {
        const d = new Date(dateStr);
        return `${DAYS_TH[d.getDay()]} ${d.getDate()} ${MONTHS_TH_SHORT[d.getMonth()]} ${((d.getFullYear() + 543).toString().slice(-2))}`;
      };

      const getDayNameFromDate = (dateStr) => DAYS_TH[new Date(dateStr).getDay()];

      const availableClasses = currentForm.teacherName ? 
        scheduleData.filter(s => s.teacherName === currentForm.teacherName && s.day === getDayNameFromDate(currentForm.date) && s.subject !== 'ว่าง') : [];

      const togglePeriod = (p) => {
        const pSet = new Set(currentForm.selectedPeriods);
        pSet.has(p) ? pSet.delete(p) : pSet.add(p);
        setCurrentForm({...currentForm, selectedPeriods: Array.from(pSet).sort()});
      };

      const handleAddLeave = () => {
        if (!currentForm.teacherName || currentForm.selectedPeriods.length === 0) return alert('กรุณาเลือกครูและคลิกเลือกคาบสอนที่ต้องการจัดแทน');
        setLeaveRequests([...leaveRequests, { ...currentForm, id: Date.now(), displayDate: formatThaiDate(currentForm.date) }]);
        setCurrentForm({...currentForm, teacherName: '', selectedPeriods: []});
      };

      const calculateSubstitutes = () => {
        let newAss = [];
        let dailyLimit = {};
        
        leaveRequests.forEach(leave => {
          const dayName = getDayNameFromDate(leave.date);
          const classesToCover = scheduleData.filter(s => s.teacherName === leave.teacherName && s.day === dayName && leave.selectedPeriods.includes(s.period));

          classesToCover.forEach(cls => {
            let freeCandidates = scheduleData.filter(s => s.day === dayName && s.period === cls.period && s.subject === 'ว่าง');
            freeCandidates = freeCandidates.filter(c => !leaveRequests.some(l => l.teacherName === c.teacherName && l.date === leave.date && l.selectedPeriods.includes(c.period)));
            
            let scoredFree = freeCandidates.map(c => {
              let score = 100;
              const tInfo = teachersList.find(t => t.name === c.teacherName);
              if (tInfo?.dept === cls.dept) score += 30;
              if (dailyLimit[`${leave.date}_${c.teacherName}`]) score -= 60;
              score -= (stats[c.teacherName]?.subCount || 0) * 5;
              if (SPECIAL_ROLES[c.teacherName]) score -= 500; 
              return { name: c.teacherName, score, dept: tInfo?.dept, isFree: true };
            }).sort((a,b) => b.score - a.score);

            let busyCandidates = teachersList.filter(t => !freeCandidates.some(fc => fc.teacherName === t.name));
            busyCandidates = busyCandidates.filter(c => !leaveRequests.some(l => l.teacherName === c.name && l.date === leave.date && l.selectedPeriods.includes(cls.period)));
            
            let scoredBusy = busyCandidates.map(c => {
               return { name: c.name, score: -1000, dept: c.dept, isFree: false };
            });

            const allOptions = [...scoredFree, ...scoredBusy];
            const selected = scoredFree.length > 0 ? scoredFree[0].name : 'ไม่มีครูว่าง';
            if (selected !== 'ไม่มีครูว่าง') dailyLimit[`${leave.date}_${selected}`] = true;

            newAss.push({
              id: Math.random(), leaveId: leave.id, leaveName: cls.teacherName, reason: leave.reason,
              date: leave.date, displayDate: leave.displayDate,
              period: cls.period, subject: cls.subject, grade: cls.grade, room: cls.room,
              subName: selected, options: allOptions
            });
          });
        });
        newAss.sort((a, b) => a.period - b.period);
        setAssignments(newAss);
      };

      const handleCopyText = (leaveReq, reqAssignments) => {
        let text = `วันนี้ ครู${leaveReq.teacherName} ลา${leaveReq.reason} ขออนุญาตจัดสอนแทนดังนี้\n`;
        reqAssignments.forEach(a => {
            text += `คาบที่ ${a.period} (${a.subject} ${a.grade} ห้อง ${a.room}) -> สอนแทนโดย: ${a.subName}\n`;
        });
        navigator.clipboard.writeText(text).then(() => {
            alert('คัดลอกข้อความสำเร็จแล้ว สามารถนำไปวางได้เลยครับ!');
        });
      };

      const handleDownloadImage = (dateStr) => {
        const elementId = `master-grid-${dateStr}`;
        const element = document.getElementById(elementId);
        if (element) {
          html2canvas(element, { scale: 2, backgroundColor: '#ffffff' }).then(canvas => {
            const link = document.createElement('a');
            link.download = `ตารางสรุปสอนแทน_${dateStr}.png`;
            link.href = canvas.toDataURL('image/png');
            link.click();
          });
        }
      };

      const executeSave = () => {
        setIsSaving(true);
        let newStats = { ...stats };
        
        leaveRequests.forEach(req => { 
          if(newStats[req.teacherName]) {
            newStats[req.teacherName].leaveCount += 1;
            newStats[req.teacherName].leaveHistory.push({
              date: req.date, displayDate: req.displayDate, reason: req.reason, periods: req.selectedPeriods.join(', ')
            });
          } 
        });

        assignments.forEach(ass => {
          if (ass.subName !== 'ไม่มีครูว่าง' && newStats[ass.subName]) {
            newStats[ass.subName].subCount += 1;
          }
        });
        
        setStats(newStats);
        google.script.run.saveStats(JSON.stringify(newStats));
        google.script.run.withSuccessHandler(() => {
          setIsSaving(false);
          setShowConfirmModal(false);
          setHasSaved(true);
          setShowSuccessModal(true); 
        }).saveToSheet(leaveRequests, assignments);
      };

      const handleClearAll = () => {
         setLeaveRequests([]);
         setAssignments([]);
         setHasSaved(false);
      };

      if (isLoading) return <div className="h-screen flex flex-col items-center justify-center text-indigo-600 font-bold"><div className="animate-spin rounded-full h-12 w-12 border-b-4 border-indigo-600 mb-4"></div>กำลังเชื่อมต่อฐานข้อมูล Sheet...</div>;

      const datesInAssignments = [...new Set(assignments.map(a => a.date))];

      return (
        <div className="max-w-7xl mx-auto p-4 md:p-8">
          
          <header className="mb-8 flex flex-col md:flex-row justify-between items-center bg-white p-4 rounded-3xl shadow-sm border border-slate-100">
            <div className="text-center md:text-left mb-4 md:mb-0 ml-4">
              <h1 className="text-2xl md:text-3xl font-bold gradient-text">ระบบจัดสอนแทน โรงเรียนพระนารายณ์</h1>
            </div>
            <div className="flex bg-slate-100 p-1 rounded-2xl overflow-x-auto">
              <button onClick={() => setActiveTab('manage')} className={`px-4 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap transition-all ${activeTab === 'manage' ? 'bg-white text-indigo-700 shadow-sm' : 'text-slate-500 hover:text-slate-700'}`}>📅 จัดตารางสอนแทน</button>
              <button onClick={() => setActiveTab('schedule')} className={`px-4 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap transition-all ${activeTab === 'schedule' ? 'bg-white text-indigo-700 shadow-sm' : 'text-slate-500 hover:text-slate-700'}`}>🗓️ ตารางสอนรวม</button>
              <button onClick={() => setActiveTab('dashboard')} className={`px-4 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap transition-all ${activeTab === 'dashboard' ? 'bg-white text-indigo-700 shadow-sm' : 'text-slate-500 hover:text-slate-700'}`}>📊 แดชบอร์ดสถิติ</button>
            </div>
          </header>

          {activeTab === 'manage' && (
            <div className="grid grid-cols-1 lg:grid-cols-12 gap-8">
              <div className="lg:col-span-4 space-y-6">
                <div className="glass-card rounded-3xl p-6">
                  <h2 className="text-xl font-bold mb-5 flex items-center text-indigo-800"><span className="w-2 h-6 bg-indigo-500 rounded-full mr-2"></span>บันทึกการลา</h2>
                  <div className="space-y-4">
                    <div>
                      <label className="text-xs text-indigo-600 font-bold uppercase tracking-widest mb-1 block">เลือกครูผู้ลา</label>
                      <select className="w-full bg-white border border-slate-200 rounded-xl p-3 text-sm focus:ring-2 focus:ring-indigo-400 outline-none shadow-sm" value={currentForm.teacherName} onChange={e => setCurrentForm({...currentForm, teacherName: e.target.value, selectedPeriods: []})}>
                        <option value="">-- เลือกรายชื่อ --</option>
                        {teachersList.map(t => <option key={t.name} value={t.name}>{t.name}</option>)}
                      </select>
                    </div>

                    <div className="grid grid-cols-2 gap-4">
                      <div>
                        <label className="text-xs text-indigo-600 font-bold uppercase tracking-widest mb-1 block">ประเภท</label>
                        <select className="w-full bg-white border border-slate-200 rounded-xl p-3 text-sm focus:ring-2 focus:ring-indigo-400 outline-none shadow-sm" value={currentForm.reason} onChange={e => setCurrentForm({...currentForm, reason: e.target.value})}>
                          {LEAVE_TYPES.map(r => <option key={r} value={r}>{r}</option>)}
                        </select>
                      </div>
                      <div>
                        <label className="text-xs text-indigo-600 font-bold uppercase tracking-widest mb-1 block">วันที่ลา</label>
                        <input type="date" className="w-full bg-white border border-slate-200 rounded-xl p-3 text-sm focus:ring-2 focus:ring-indigo-400 outline-none shadow-sm" value={currentForm.date} onChange={e => setCurrentForm({...currentForm, date: e.target.value, selectedPeriods: []})} />
                      </div>
                    </div>

                    {currentForm.teacherName && (
                      <div className="bg-slate-50 p-3 rounded-2xl border border-slate-100">
                        <label className="text-xs text-indigo-600 font-bold uppercase tracking-widest mb-2 block">คลิกเลือกคาบที่ต้องการจัดสอนแทน</label>
                        <div className="grid grid-cols-4 gap-2">
                          {availableClasses.length > 0 ? availableClasses.map(c => (
                            <div key={c.period} onClick={() => togglePeriod(c.period)} className={`period-chip cursor-pointer rounded-xl p-2 text-center text-xs shadow-sm ${currentForm.selectedPeriods.includes(c.period) ? 'active' : 'text-slate-600'}`}>
                              <div className="font-bold mb-1">คาบ {c.period}</div>
                              <div className="text-[10px] truncate">{c.subject}</div>
                            </div>
                          )) : <div className="col-span-4 text-center text-xs text-rose-500 py-2 bg-rose-50 rounded-lg">ไม่มีตารางสอนในวัน{getDayNameFromDate(currentForm.date)}</div>}
                        </div>
                      </div>
                    )}

                    <button onClick={handleAddLeave} className="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold py-3 rounded-2xl shadow-lg shadow-indigo-200 transition-all">
                      + เพิ่มรายชื่อลงคิว
                    </button>
                  </div>
                </div>

                {leaveRequests.length > 0 && (
                  <div className="glass-card rounded-3xl p-5 border-l-4 border-amber-400">
                    <h3 className="text-sm font-bold text-amber-600 mb-3 uppercase">คิวรอประมวลผล ({leaveRequests.length})</h3>
                    <div className="space-y-2">
                      {leaveRequests.map(l => (
                        <div key={l.id} className="flex justify-between items-center text-sm bg-white p-3 rounded-xl border border-slate-100 shadow-sm">
                          <span className="font-medium text-slate-700">
                            {l.teacherName} <span className="text-[10px] bg-slate-100 px-2 py-0.5 rounded text-slate-500 mx-1">{l.reason}</span>
                            <div className="text-xs text-slate-400 mt-1">คาบที่: {l.selectedPeriods.join(', ')}</div>
                          </span>
                          <button onClick={() => setLeaveRequests(leaveRequests.filter(x => x.id !== l.id))} className="text-rose-500 hover:text-rose-700 font-bold bg-rose-50 px-2 py-1 rounded">ลบ</button>
                        </div>
                      ))}
                    </div>
                    <button onClick={calculateSubstitutes} className="w-full mt-4 bg-emerald-500 hover:bg-emerald-600 text-white py-3 rounded-xl text-sm font-bold shadow-md shadow-emerald-200 transition-all">
                      ✨ เริ่มจัดครูสอนแทนอัตโนมัติ
                    </button>
                  </div>
                )}
              </div>

              <div className="lg:col-span-8 space-y-8">
                {assignments.length > 0 ? (
                  <div className="glass-card rounded-3xl overflow-hidden shadow-xl animate-in fade-in duration-500">
                    
                    {leaveRequests.map(leaveReq => {
                      const reqAssignments = assignments.filter(a => a.leaveId === leaveReq.id);
                      if (reqAssignments.length === 0) return null;
                      
                      return (
                        <div key={leaveReq.id} className="mb-6">
                          <div className="bg-gradient-to-r from-rose-50 to-white px-6 py-4 border-b border-rose-100 flex items-center justify-between">
                            <div className="flex items-center">
                              <div className="w-10 h-10 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center font-bold text-xl mr-3">👤</div>
                              <div>
                                <div className="text-sm text-rose-500 font-bold">ครูที่ลา:</div>
                                <div className="text-lg font-bold text-rose-700">{leaveReq.teacherName} <span className="text-sm font-normal bg-white border border-rose-200 px-2 py-0.5 rounded-full ml-2 text-rose-500">{leaveReq.reason}</span></div>
                              </div>
                            </div>
                            <button onClick={() => handleCopyText(leaveReq, reqAssignments)} className="bg-white border border-rose-200 text-rose-600 hover:bg-rose-50 px-4 py-2 rounded-xl text-sm font-bold shadow-sm transition-colors flex items-center">
                              <svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                              </svg>
                              คัดลอกข้อความ
                            </button>
                          </div>
                          
                          <div className="overflow-x-auto">
                            <table className="w-full text-left text-sm">
                              <thead>
                                <tr className="bg-slate-50/80 text-slate-600">
                                  <th className="p-3 pl-6 font-bold border-b border-slate-200 w-24 text-center">คาบที่</th>
                                  <th className="p-3 font-bold border-b border-slate-200 w-40">วันที่</th>
                                  <th className="p-3 font-bold border-b border-slate-200">วิชา / ชั้น / ห้อง</th>
                                  <th className="p-3 pr-6 font-bold border-b border-slate-200 w-64">ผู้สอนแทน (คลิกเพื่อเปลี่ยน)</th>
                                </tr>
                              </thead>
                              <tbody className="divide-y divide-slate-100 bg-white/60">
                                {reqAssignments.map(ass => (
                                  <tr key={ass.id} className="hover:bg-blue-50/50 transition-colors">
                                    <td className="p-3 pl-6 text-center">
                                      <div className="bg-indigo-100 text-indigo-800 w-8 h-8 rounded-full flex items-center justify-center font-bold mx-auto">{ass.period}</div>
                                    </td>
                                    <td className="p-3 whitespace-nowrap">
                                      <div className="font-bold text-indigo-700 text-sm">{ass.displayDate}</div>
                                    </td>
                                    <td className="p-3">
                                      <div className="font-bold text-indigo-700 text-sm">
                                        {ass.subject} {ass.grade} ห้อง {ass.room}
                                      </div>
                                    </td>
                                    <td className="p-3 pr-6">
                                      <select className={`bg-white border rounded-lg p-2 text-sm w-full font-bold focus:ring-2 outline-none shadow-sm ${ass.subName === 'ไม่มีครูว่าง' ? 'border-rose-300 text-rose-600 focus:ring-rose-400' : 'border-emerald-200 text-emerald-700 focus:ring-emerald-400'}`}
                                        value={ass.subName} onChange={e => setAssignments(assignments.map(a => a.id === ass.id ? {...a, subName: e.target.value} : a))}>
                                        <option value="ไม่มีครูว่าง" className="text-rose-500">-- เลือกผู้สอนแทน --</option>
                                        {ass.options.map(opt => (
                                          <option key={opt.name} value={opt.name} className={!opt.isFree ? "text-slate-400" : ""}>
                                            {opt.name} 
                                            {SPECIAL_ROLES[opt.name] ? ` (${SPECIAL_ROLES[opt.name] === 'เจ้าหน้าที่สำนักงาน' ? 'สนง.' : 'หัวหน้าฯ'})` : ''}
                                            {!opt.isFree ? ' ⚠️ (มีสอน)' : ''}
                                          </option>
                                        ))}
                                      </select>
                                    </td>
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </div>
                        </div>
                      )
                    })}

                    <div className="p-4 bg-slate-50 border-t border-slate-100 flex justify-end gap-3">
                      {hasSaved && (
                         <button onClick={handleClearAll} className="bg-slate-200 hover:bg-slate-300 text-slate-700 px-6 py-2.5 rounded-xl font-bold transition-all flex items-center">
                           <span className="mr-2">🧹</span> ล้างหน้าจอ
                         </button>
                      )}
                      <button onClick={() => setShowConfirmModal(true)} disabled={isSaving} className={`bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-2.5 rounded-xl font-bold shadow-md transition-all flex items-center ${isSaving ? 'opacity-50 cursor-not-allowed' : ''}`}>
                        {isSaving ? 'กำลังบันทึก...' : (
                           hasSaved ? <><span className="mr-2">🔄</span> อัปเดตข้อมูล</> : <><span className="mr-2">💾</span> บันทึกและอัปเดตสถิติลงระบบ</>
                        )}
                      </button>
                    </div>
                  </div>
                ) : (
                  <div className="h-full flex flex-col items-center justify-center text-slate-400 glass-card rounded-3xl p-10 min-h-[400px]">
                    <div className="text-6xl mb-4 opacity-50">📅</div>
                    <p className="text-xl font-bold text-slate-600">ยังไม่มีข้อมูลการจัดสอนแทน</p>
                    <p className="text-sm mt-2">กรุณาระบุข้อมูลการลาด้านซ้ายเพื่อประมวลผล</p>
                  </div>
                )}

                {/* Master Grid Section */}
                {datesInAssignments.map(date => {
                  const dayAssignments = assignments.filter(a => a.date === date);
                  const assignedSubs = [...new Set(dayAssignments.map(a => a.subName).filter(n => n !== 'ไม่มีครูว่าง'))];
                  const dayName = getDayNameFromDate(date);
                  
                  const absentTeachers = leaveRequests.filter(l => l.date === date).map(l => l.teacherName);
                  const regularTeachers = teachersList.map(t => t.name).filter(n => !assignedSubs.includes(n) && !absentTeachers.includes(n));

                  if (assignedSubs.length === 0 && regularTeachers.length === 0) return null;

                  return (
                    <div key={date} className="glass-card rounded-3xl overflow-hidden shadow-xl mt-8">
                      <div className="p-4 bg-indigo-50 flex justify-end">
                        <button onClick={() => handleDownloadImage(date)} className="bg-indigo-600 text-white hover:bg-indigo-700 px-5 py-2.5 rounded-xl text-sm font-bold shadow-md transition-colors flex items-center">
                          <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                          </svg>
                          ดาวน์โหลดภาพตาราง
                        </button>
                      </div>
                      
                      {/* ครอบบริเวณที่ 1 (ภาพดาวน์โหลด) ที่จะโดนแคปเจอร์ เฉพาะหัวตารางและครูที่สอนแทน */}
                      <div className="bg-white">
                        <div id={`master-grid-${date}`} className="p-6 bg-white">
                          <div className="mb-6 border-b border-slate-100 pb-5">
                            <h3 className="text-2xl font-bold text-indigo-900 mb-3">
                               ตารางสรุปการเข้าสอนแทน ประจำวัน{formatThaiDate(date)}
                            </h3>
                            <div className="flex flex-wrap items-center gap-2">
                              <span className="font-bold text-rose-600 text-sm">รายชื่อครูที่ลา:</span>
                              {leaveRequests.filter(l => l.date === date).map(l => (
                                 <span key={l.id} className="bg-rose-50 text-rose-700 px-2 py-1 rounded border border-rose-100 text-sm font-bold">
                                   {l.teacherName} (คาบ {l.selectedPeriods.join(', ')})
                                 </span>
                              ))}
                            </div>
                          </div>
                          
                          {/* 1. ตารางครูที่ถูกจัดให้สอนแทน (ถูกครอบอยู่ในรหัสที่จะโหลดภาพ) */}
                          {assignedSubs.length > 0 && (
                            <div className="overflow-x-auto pb-2">
                              <h4 className="text-lg font-bold text-indigo-800 mb-3">คุณครูที่ทำหน้าที่สอนแทน</h4>
                              <table className="w-full text-center text-sm border-collapse border border-slate-300">
                                <thead>
                                  <tr className="bg-indigo-600 text-white">
                                    <th className="p-3 border border-indigo-700 font-medium rounded-tl-lg text-left w-64">รายชื่อครู</th>
                                    {PERIODS.map(p => <th key={p} className="p-3 border border-indigo-700 font-medium w-24">คาบ {p}</th>)}
                                  </tr>
                                </thead>
                                <tbody>
                                  {assignedSubs.map(subName => {
                                    const nameParts = subName.split(' ');
                                    const firstName = nameParts[0];
                                    const lastName = nameParts.length > 1 ? nameParts.slice(1).join(' ') : '';
                                    const role = SPECIAL_ROLES[subName];

                                    return (
                                      <tr key={subName} className="bg-white">
                                        <td className="p-3 border border-slate-300 text-left">
                                          <div className="font-bold text-slate-700 text-sm">{firstName}</div>
                                          {lastName && <div className="font-bold text-slate-700 text-sm">{lastName}</div>}
                                          {role && (
                                            <div className={`inline-block mt-1 text-[10px] px-2 py-0.5 rounded ${role === 'เจ้าหน้าที่สำนักงาน' ? 'bg-sky-100 text-sky-700' : 'bg-amber-100 text-amber-700'}`}>
                                              {role}
                                            </div>
                                          )}
                                        </td>
                                        {PERIODS.map(p => {
                                          const subClass = dayAssignments.find(a => a.subName === subName && a.period === p);
                                          const regClass = scheduleData.find(s => s.teacherName === subName && s.day === dayName && s.period === p && s.subject !== 'ว่าง');

                                          if (subClass) {
                                            return (
                                              <td key={p} className="p-2 border border-slate-300 bg-rose-50 text-rose-700">
                                                <div className="text-[10px] bg-rose-500 text-white rounded-full px-2 py-0.5 inline-block mb-1 font-bold">สอนแทน</div>
                                                <div className="font-bold text-xs">{subClass.subject}</div>
                                                <div className="text-[10px]">{subClass.grade} <br/> ({subClass.room})</div>
                                              </td>
                                            );
                                          }
                                          if (regClass) {
                                            return (
                                              <td key={p} className="p-2 border border-slate-300 bg-emerald-50 text-emerald-700">
                                                <div className="text-[10px] text-emerald-600 font-bold mb-1">สอนปกติ</div>
                                                <div className="font-bold text-xs">{regClass.subject}</div>
                                                <div className="text-[10px]">{regClass.grade} <br/> ({regClass.room})</div>
                                              </td>
                                            );
                                          }
                                          return <td key={p} className="p-2 border border-slate-300 text-slate-300 text-xs">ว่าง</td>;
                                        })}
                                      </tr>
                                    );
                                  })}
                                </tbody>
                              </table>
                            </div>
                          )}
                        </div>

                        {/* 2. ตารางครูที่ไม่ได้สอนแทน (โชว์แยกส่วน และอยู่นอกพื้นที่ดาวน์โหลด) */}
                        {regularTeachers.length > 0 && (
                          <div className="p-6 pt-0 bg-white">
                            <div className="overflow-x-auto pb-4">
                              <h4 className="text-lg font-bold text-slate-700 mb-3 border-t-2 border-slate-100 pt-4">ตารางสอนคุณครูท่านอื่น (ไม่ได้จัดสอนแทน)</h4>
                              <table className="w-full text-center text-sm border-collapse border border-slate-300">
                                <thead>
                                  <tr className="bg-slate-600 text-white">
                                    <th className="p-3 border border-slate-700 font-medium rounded-tl-lg text-left w-64">รายชื่อครู</th>
                                    {PERIODS.map(p => <th key={p} className="p-3 border border-slate-700 font-medium w-24">คาบ {p}</th>)}
                                  </tr>
                                </thead>
                                <tbody>
                                  {regularTeachers.map(teacherName => {
                                    const nameParts = teacherName.split(' ');
                                    const firstName = nameParts[0];
                                    const lastName = nameParts.length > 1 ? nameParts.slice(1).join(' ') : '';
                                    const role = SPECIAL_ROLES[teacherName];

                                    return (
                                      <tr key={teacherName} className="bg-white">
                                        <td className="p-3 border border-slate-300 text-left">
                                          <div className="font-bold text-slate-700 text-sm">{firstName}</div>
                                          {lastName && <div className="font-bold text-slate-700 text-sm">{lastName}</div>}
                                          {role && (
                                            <div className={`inline-block mt-1 text-[10px] px-2 py-0.5 rounded ${role === 'เจ้าหน้าที่สำนักงาน' ? 'bg-sky-100 text-sky-700' : 'bg-amber-100 text-amber-700'}`}>
                                              {role}
                                            </div>
                                          )}
                                        </td>
                                        {PERIODS.map(p => {
                                          const regClass = scheduleData.find(s => s.teacherName === teacherName && s.day === dayName && s.period === p && s.subject !== 'ว่าง');
                                          if (regClass) {
                                            return (
                                              <td key={p} className="p-2 border border-slate-300 bg-emerald-50 text-emerald-700">
                                                <div className="text-[10px] text-emerald-600 font-bold mb-1">สอนปกติ</div>
                                                <div className="font-bold text-xs">{regClass.subject}</div>
                                                <div className="text-[10px]">{regClass.grade} <br/> ({regClass.room})</div>
                                              </td>
                                            );
                                          }
                                          return <td key={p} className="p-2 border border-slate-300 text-slate-300 text-xs">ว่าง</td>;
                                        })}
                                      </tr>
                                    );
                                  })}
                                </tbody>
                              </table>
                            </div>
                          </div>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {/* TAB 2: ตารางสอนรวมทั้งหมด */}
          {activeTab === 'schedule' && (
            <div className="glass-card rounded-3xl p-6 shadow-xl animate-in fade-in duration-500">
              <div className="flex flex-col md:flex-row justify-between items-center mb-6 border-b border-slate-100 pb-4">
                <h2 className="text-2xl font-bold text-indigo-900 flex items-center mb-4 md:mb-0">
                  <span className="mr-2">🗓️</span> ตารางสอนรวมทุกคาบ
                </h2>
                <div className="flex items-center bg-indigo-50 p-2 rounded-xl">
                  <label className="text-sm font-bold text-indigo-700 mr-3">เลือกดูตารางสอนของวัน:</label>
                  <select 
                    className="bg-white border border-indigo-200 rounded-lg p-2 text-sm font-bold focus:ring-2 focus:ring-indigo-400 outline-none shadow-sm text-indigo-900"
                    value={selectedScheduleDay}
                    onChange={(e) => setSelectedScheduleDay(e.target.value)}
                  >
                    {['จันทร์', 'อังคาร', 'พุธ', 'พฤหัสบดี', 'ศุกร์'].map(d => <option key={d} value={d}>วัน{d}</option>)}
                  </select>
                </div>
              </div>

              <div className="overflow-x-auto pb-4">
                <table className="w-full text-center text-sm border-collapse border border-slate-300">
                  <thead>
                    <tr className="bg-indigo-600 text-white">
                      <th className="p-3 border border-indigo-700 font-medium rounded-tl-lg text-left w-64">รายชื่อครู</th>
                      {PERIODS.map(p => <th key={p} className="p-3 border border-indigo-700 font-medium w-24">คาบ {p}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {teachersList.map(t => {
                      const teacherName = t.name;
                      const nameParts = teacherName.split(' ');
                      const firstName = nameParts[0];
                      const lastName = nameParts.length > 1 ? nameParts.slice(1).join(' ') : '';
                      const role = SPECIAL_ROLES[teacherName];

                      return (
                        <tr key={teacherName} className="bg-white hover:bg-indigo-50/50 transition-colors">
                          <td className="p-3 border border-slate-300 text-left">
                            <div className="font-bold text-slate-700 text-sm">{firstName}</div>
                            {lastName && <div className="font-bold text-slate-700 text-sm">{lastName}</div>}
                            {role && (
                              <div className={`inline-block mt-1 text-[10px] px-2 py-0.5 rounded ${role === 'เจ้าหน้าที่สำนักงาน' ? 'bg-sky-100 text-sky-700' : 'bg-amber-100 text-amber-700'}`}>
                                {role}
                              </div>
                            )}
                          </td>
                          {PERIODS.map(p => {
                            const regClass = scheduleData.find(s => s.teacherName === teacherName && s.day === selectedScheduleDay && s.period === p && s.subject !== 'ว่าง');
                            if (regClass) {
                              return (
                                <td key={p} className="p-2 border border-slate-300 bg-emerald-50 text-emerald-700">
                                  <div className="font-bold text-xs">{regClass.subject}</div>
                                  <div className="text-[10px]">{regClass.grade} <br/> ({regClass.room})</div>
                                </td>
                              );
                            }
                            return <td key={p} className="p-2 border border-slate-300 text-slate-300 text-xs">ว่าง</td>;
                          })}
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {/* TAB 3: แดชบอร์ด */}
          {activeTab === 'dashboard' && (
             <div className="grid grid-cols-1 md:grid-cols-2 gap-8 animate-in fade-in duration-500">
               <div className="glass-card rounded-3xl p-6 shadow-xl">
                 <h3 className="text-xl font-bold text-indigo-900 mb-6 flex items-center">
                   <span className="text-2xl mr-2">🏆</span> สถิติการเข้าสอนแทน (จำนวนคาบสะสม)
                 </h3>
                 <div className="space-y-4 max-h-[600px] overflow-y-auto pr-2">
                   {teachersList.sort((a,b) => (stats[b.name]?.subCount || 0) - (stats[a.name]?.subCount || 0)).map(t => {
                     const count = stats[t.name]?.subCount || 0;
                     const maxCount = Math.max(...teachersList.map(x => stats[x.name]?.subCount || 0), 10);
                     const widthPercent = (count / maxCount) * 100;
                     if(count === 0) return null;
                     return (
                       <div key={t.name} className="relative">
                         <div className="flex justify-between items-end mb-1">
                           <span className="text-sm font-bold text-slate-700">{t.name}</span>
                           <span className="text-xs font-bold bg-emerald-100 text-emerald-700 px-2 rounded-full">{count} คาบ</span>
                         </div>
                         <div className="w-full bg-slate-100 rounded-full h-2.5">
                           <div className="bg-gradient-to-r from-emerald-400 to-emerald-500 h-2.5 rounded-full" style={{ width: `${widthPercent}%` }}></div>
                         </div>
                       </div>
                     )
                   })}
                 </div>
               </div>

               <div className="glass-card rounded-3xl p-6 shadow-xl">
                 <h3 className="text-xl font-bold text-rose-900 mb-2 flex items-center">
                   <span className="text-2xl mr-2">🤒</span> สถิติการลา (คลิกเพื่อดูประวัติ)
                 </h3>
                 <p className="text-xs text-slate-400 mb-4 ml-8">*กดที่แถบชื่อเพื่อดูรายละเอียดการลาแยกตามประเภท</p>
                 <div className="space-y-4 max-h-[600px] overflow-y-auto pr-2 pb-4">
                   {teachersList.sort((a,b) => (stats[b.name]?.leaveCount || 0) - (stats[a.name]?.leaveCount || 0)).map(t => {
                     const count = stats[t.name]?.leaveCount || 0;
                     const maxCount = Math.max(...teachersList.map(x => stats[x.name]?.leaveCount || 0), 5);
                     const widthPercent = (count / maxCount) * 100;
                     if(count === 0) return null;
                     return (
                       <div key={t.name} className="relative clickable-bar" onClick={() => setSelectedTeacherLeave(t.name)}>
                         <div className="flex justify-between items-end mb-1">
                           <span className="text-sm font-bold text-slate-700 hover:text-rose-600">{t.name}</span>
                           <span className="text-xs font-bold bg-rose-100 text-rose-700 px-2 rounded-full">{count} ครั้ง</span>
                         </div>
                         <div className="w-full bg-slate-100 rounded-full h-2.5">
                           <div className="bg-gradient-to-r from-rose-400 to-rose-500 h-2.5 rounded-full" style={{ width: `${widthPercent}%` }}></div>
                         </div>
                       </div>
                     )
                   })}
                 </div>
               </div>
             </div>
          )}

          {/* Popup Modal: ดูประวัติการลา */}
          {selectedTeacherLeave && (
            <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 p-4">
              <div className="bg-white rounded-3xl p-6 w-full max-w-lg shadow-2xl animate-in zoom-in-95 duration-200">
                <div className="flex justify-between items-center mb-4 border-b border-slate-100 pb-3">
                  <h3 className="text-xl font-bold text-rose-700 flex items-center">
                    <span className="mr-2">📋</span> ประวัติการลาของ: <span className="ml-2 text-slate-800">{selectedTeacherLeave}</span>
                  </h3>
                  <button onClick={() => setSelectedTeacherLeave(null)} className="text-slate-400 hover:text-rose-500 font-bold text-2xl transition-colors">&times;</button>
                </div>
                <div className="max-h-96 overflow-y-auto pr-2">
                  {LEAVE_TYPES.map(reason => {
                     const historyList = stats[selectedTeacherLeave]?.leaveHistory?.filter(h => h.reason === reason) || [];
                     if (historyList.length === 0) return null;
                     return (
                       <div key={reason} className="mb-5 bg-slate-50 p-4 rounded-2xl border border-slate-100">
                         <h4 className="font-bold text-slate-800 flex items-center mb-3">
                           <div className="w-2 h-4 bg-rose-400 rounded-full mr-2"></div>
                           {reason} <span className="ml-2 text-xs bg-rose-100 text-rose-600 px-2 py-0.5 rounded-full">{historyList.length} รายการ</span>
                         </h4>
                         <ul className="space-y-3">
                           {historyList.map((h, i) => (
                             <li key={i} className="text-sm bg-white border border-slate-200 p-2 rounded-xl flex flex-col">
                               <span className="font-bold text-indigo-700">{h.displayDate}</span>
                               <span className="text-slate-500 text-xs mt-1">
                                 ช่วงคาบที่ลา: <span className="font-bold text-slate-700 bg-slate-100 px-2 py-0.5 rounded">{h.periods}</span>
                               </span>
                             </li>
                           ))}
                         </ul>
                       </div>
                     )
                  })}
                  {(!stats[selectedTeacherLeave]?.leaveHistory || stats[selectedTeacherLeave].leaveHistory.length === 0) && (
                    <div className="text-center text-slate-400 py-8 flex flex-col items-center">
                      <span className="text-4xl mb-2 opacity-50">📂</span>
                      ไม่มีข้อมูลประวัติการลาที่ถูกบันทึกไว้
                    </div>
                  )}
                </div>
                <div className="mt-4 pt-4 border-t border-slate-100 text-center">
                  <button onClick={() => setSelectedTeacherLeave(null)} className="bg-slate-800 hover:bg-slate-900 text-white px-6 py-2 rounded-xl font-bold text-sm transition-colors">
                    ปิดหน้าต่าง
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* Popup Modal: ยืนยันการบันทึก */}
          {showConfirmModal && (
            <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 p-4">
              <div className="bg-white rounded-3xl p-6 w-full max-w-md shadow-2xl animate-in zoom-in-95 duration-200 border-2 border-indigo-200">
                <div className="text-center mb-6">
                  <div className="w-20 h-20 bg-indigo-50 text-indigo-500 rounded-full flex items-center justify-center text-4xl mx-auto mb-4 shadow-inner">
                    💾
                  </div>
                  <h3 className="text-2xl font-bold text-indigo-900 mb-2">ยืนยันการบันทึกข้อมูล</h3>
                  <p className="text-slate-500 text-sm">คุณตรวจสอบความถูกต้องครบถ้วน และต้องการบันทึกตารางการสอนแทนนี้ลงในระบบใช่หรือไม่?</p>
                  {hasSaved && <p className="text-rose-500 text-xs mt-3 bg-rose-50 p-2 rounded-lg font-bold">* ข้อควรระวัง: การกดอัปเดตจะเป็นการบันทึกประวัติซ้ำลงในฐานข้อมูล</p>}
                </div>
                <div className="flex gap-4">
                  <button onClick={() => setShowConfirmModal(false)} className="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 py-3 rounded-xl font-bold transition-colors">
                    ยกเลิก
                  </button>
                  <button onClick={executeSave} disabled={isSaving} className="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-xl font-bold shadow-lg shadow-indigo-200 transition-colors">
                    {isSaving ? 'กำลังบันทึก...' : 'ยืนยันการบันทึก'}
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* Popup Modal: บันทึกสำเร็จ */}
          {showSuccessModal && (
            <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 p-4">
              <div className="bg-white rounded-3xl p-6 w-full max-w-md shadow-2xl animate-in zoom-in-95 duration-200 border-2 border-emerald-300">
                <div className="text-center mb-6">
                  <div className="w-20 h-20 bg-emerald-50 text-emerald-500 rounded-full flex items-center justify-center text-4xl mx-auto mb-4 shadow-inner">
                    ✅
                  </div>
                  <h3 className="text-2xl font-bold text-emerald-700 mb-2">บันทึกสำเร็จเรียบร้อย!</h3>
                  <p className="text-slate-500 text-sm">ข้อมูลการจัดสอนแทนและสถิติ ถูกอัปเดตลงในฐานข้อมูล Google Sheets ของคุณเรียบร้อยแล้ว</p>
                  <p className="text-slate-400 text-xs mt-3">ข้อมูลบนหน้าจอยังคงอยู่ เพื่อให้คุณสามารถตรวจทาน ดาวน์โหลดรูปภาพ หรืออัปเดตข้อมูลเพิ่มเติมได้</p>
                </div>
                <button onClick={() => setShowSuccessModal(false)} className="w-full bg-emerald-500 hover:bg-emerald-600 text-white py-3 rounded-xl font-bold shadow-lg shadow-emerald-200 transition-colors">
                  ตกลง
                </button>
              </div>
            </div>
          )}

        </div>
      );
    }

    ReactDOM.render(<App />, document.getElementById('root'));
  </script>
</body>
</html>
